+/*
+ * noVNC-ARD: ARD ArdThousands (encoding 1002) decoder.
+ * 16-bit RGB555, zlib compressed. MPL-2.0.
+ * Adapted for Kodex from noVNC-ARD d699293635083c9e0c30c8f9480993865653772a.
+ * Convert in strips to avoid full-frame temporary RGB555/RGBA allocations.
+ */
+import Inflator from "../inflator.js";
+
+export default class AppleThousandsDecoder {
+    constructor() {
+        this._zlib = new Inflator();
+        this._length = 0;
+        this._pixels = new Uint8Array();
+    }
+
+    decodeRect(x, y, width, height, sock, display, depth) {
+        if (width === 0 || height === 0) return true;
+        if (this._length === 0) {
+            if (sock.rQwait("Apple reduced-color length", 4)) return false;
+            this._length = sock.rQshift32();
+        }
+        if (sock.rQwait("Apple reduced-color data", this._length)) return false;
+        const data = sock.rQshiftBytes(this._length, false);
+        this._length = 0;
+        this._zlib.setInput(data);
+        const rows = Math.min(64, height);
+        if (this._pixels.length < width * rows * 4) this._pixels = new Uint8Array(width * rows * 4);
+        try {
+            for (let row = 0; row < height; row += rows) {
+                const stripHeight = Math.min(rows, height - row);
+                const count = width * stripHeight;
+                const rgb555 = this._zlib.inflate(count * 2);
+                for (let i = 0, p = 0; i < count; i++) {
+                    const word = (rgb555[i * 2] << 8) | rgb555[i * 2 + 1];
+                    const r = (word >> 10) & 31, g = (word >> 5) & 31, b = word & 31;
+                    this._pixels[p++] = (r << 3) | (r >> 2);
+                    this._pixels[p++] = (g << 3) | (g >> 2);
+                    this._pixels[p++] = (b << 3) | (b >> 2);
+                    this._pixels[p++] = 255;
+                }
+                display.blitImage(x, y + row, width, stripHeight, this._pixels, 0);
+            }
+        } finally { this._zlib.setInput(null); }
+        return true;
+    }
+}
