+/* Kodex native Apple physical-desktop monitor metadata. MPL-2.0. */
+export function parseAppleDisplayInfo(bytes) {
+    if (bytes.length < 20 || bytes.length > 4096) return null;
+    const data = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+    const count = data.getUint16(18);
+    if (data.getUint16(0) !== 5 || count > 32 || bytes.length !== 20 + count * 56) return null;
+    const width = data.getUint16(6), height = data.getUint16(8);
+    if (!width || !height) return null;
+    const displays = [];
+    for (let i = 0; i < count; i++) {
+        const p = 20 + i * 56;
+        const id = data.getUint32(p + 16), x = data.getInt16(p + 22), y = data.getInt16(p + 20);
+        const w = data.getInt16(p + 34) - data.getInt16(p + 30);
+        const h = data.getInt16(p + 32) - data.getInt16(p + 28);
+        if (id === 0xffffffff || displays.some(d => d.id === id) || w <= 0 || h <= 0) return null;
+        displays.push({ id, main: !!(data.getUint32(p + 36) & 1), x, y, width: w, height: h });
+    }
+    const selected = data.getUint32(10);
+    return { width, height, selectedDisplay: selected === 0xffffffff ? null : selected, displays };
+}
+export function appleViewerInfo() {
+    const bytes = new Uint8Array(66), data = new DataView(bytes.buffer);
+    bytes.set([33, 0, 0, 62, 0, 1]);
+    [2, 6, 1, 0, 15, 0, 0].forEach((n, i) => data.setUint32(6 + i * 4, n));
+    bytes[34] = 0xb0; bytes[36] = 0x0c; bytes[37] = 3; bytes[38] = 0x90; bytes[44] = 0x40;
+    return bytes;
+}
