{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main.tsx!",
    "src/sw.ts!",
    "src/**/*.{test,spec}.{ts,tsx}",
    "tests/**/*.ts",
    "pw-local.config.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/*.{test,spec}.{ts,tsx}!",
    "!src/test/**!",
    "!src/**/testBuilders.ts!",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreIssues": {
    "src/api/generated/**": [
      "exports",
      "types"
    ]
  },
  "ignoreBinaries": [
    "agent-browser"
  ]
}
