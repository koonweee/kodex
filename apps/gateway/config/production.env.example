KODEX_BIND=127.0.0.1:8787
KODEX_DATABASE_PATH=~/.kodex/gateway.db
KODEX_UPLOADS_DIR=/tmp/kodex/uploads
KODEX_CODEX_BINARY=codex
KODEX_CODEX_ARGS=app-server --listen stdio://
KODEX_FRONTEND_DIST=apps/web/dist

# Optional project previews. Caddy is not bundled; install it separately
# and keep this binary on PATH or point at the absolute binary path.
KODEX_CADDY_BINARY=caddy

# Preview listeners default to the concrete host from KODEX_BIND. If
# KODEX_BIND is 0.0.0.0 or [::], set this to a trusted Tailscale/VPN IP.
# KODEX_PREVIEW_BIND=100.64.0.10

# Public preview ports are globally allocated from this inclusive range.
KODEX_PREVIEW_PORT_RANGE=10000-19999

# Kodex starts an isolated Caddy process and uses this admin address. If
# another Caddy already owns it, previews degrade but the gateway still runs.
KODEX_CADDY_ADMIN_BIND=127.0.0.1:20191

# Generated Caddy config/data live under this directory by default:
# ${KODEX_DATA_DIR:-~/.kodex}/previews
# KODEX_PREVIEW_DATA_DIR=~/.kodex/previews

# Optional Web Push notifications. Generate a VAPID keypair with your
# preferred web-push tooling and keep the gateway local or trusted-VPN only.
# KODEX_VAPID_PUBLIC_KEY=base64url-public-key
# KODEX_VAPID_PRIVATE_KEY=base64url-private-key
# KODEX_VAPID_SUBJECT=mailto:you@example.com
# KODEX_NOTIFICATIONS_RECHECK_DELAY_MS=2000
