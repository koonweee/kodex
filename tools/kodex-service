LAUNCHCTL = '/bin/launchctl'
SYSTEMCTL = '/usr/bin/systemctl'


class ServiceError(Exception):
    pass


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def link(path, target):
    temporary = path.with_name(path.name + '.new')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    temporary.replace(path)


def swap_directories(left, right):
    """Exchange real directories without a missing-path window (same filesystem)."""
    if sys.platform == 'darwin':
        libc = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
        rename = libc.renamex_np
        rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        arguments = (os.fsencode(left), os.fsencode(right), 0x00000002)  # RENAME_SWAP
    elif sys.platform == 'linux':
        libc = ctypes.CDLL(None, use_errno=True)
        rename = libc.renameat2
        rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
                           ctypes.c_char_p, ctypes.c_uint]
        arguments = (-100, os.fsencode(left), -100, os.fsencode(right), 0x00000002)
    else:
        raise ServiceError('Atomic frontend replacement is unsupported on this platform')
    rename.restype = ctypes.c_int
    if rename(*arguments):
        number = ctypes.get_errno()
        raise OSError(number, os.strerror(number), str(left))


def retain_frontend_assets(left, right):
    """Keep immutable Vite assets available to tabs across deploy and rollback."""
    copies = []
    for source, destination in ((left, right), (right, left)):
        assets = source / 'assets'
        if not assets.exists():
            continue
        for path in assets.rglob('*'):
            if path.is_symlink():
                raise ServiceError('Frontend assets must not contain symbolic links')
            if not path.is_file():
                continue
            target = destination / path.relative_to(source)
            if target.exists():
                if not target.is_file() or target.read_bytes() != path.read_bytes():
                    raise ServiceError(f'Frontend asset collision: {path.relative_to(source)}')
            else:
                copies.append((path, target))
    # Check every collision before adding files to the live directory.
    for source, destination in copies:
        destination.parent.mkdir(parents=True, exist_ok=True)
        descriptor, name = tempfile.mkstemp(prefix='.asset-', dir=destination.parent)
        os.close(descriptor)
        temporary = Path(name)
        try:
            shutil.copy2(source, temporary)
            temporary.replace(destination)
        finally:
            temporary.unlink(missing_ok=True)


def frontend_revision(frontend):
    """Hash every file in a frontend bundle with its relative path."""
    digest = hashlib.sha256()
    for path in sorted(frontend.rglob('*'), key=lambda item: item.relative_to(frontend).as_posix()):
        if path.is_symlink():
            raise ServiceError('Frontend bundle must not contain symbolic links')
        if not path.is_file():
            continue
        relative = path.relative_to(frontend).as_posix().encode()
        content = path.read_bytes()
        digest.update(len(relative).to_bytes(8, 'big'))
        digest.update(relative)
        digest.update(len(content).to_bytes(8, 'big'))
        digest.update(content)
    return digest.hexdigest()


def validated_http_url(value, label, expected_path):
    if not isinstance(value, str) or value != value.strip():
        raise ServiceError(f'{label} must be an exact HTTP(S) URL')
    parsed = urllib.parse.urlsplit(value)
    try:
        port = parsed.port
    except ValueError as error:
        raise ServiceError(f'{label} must be an exact HTTP(S) URL') from error
    if (parsed.scheme.lower() not in ('http', 'https') or not parsed.netloc
            or parsed.hostname is None or parsed.username is not None or parsed.password is not None
            or parsed.path != expected_path or parsed.query or parsed.fragment):
        raise ServiceError(f'{label} must be an exact HTTP(S) URL')
    effective_port = port or (443 if parsed.scheme.lower() == 'https' else 80)
    origin = (parsed.scheme.lower(), parsed.hostname.lower().rstrip('.'), effective_port)
    return parsed, origin


def check_port(port):
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            listener.bind(('127.0.0.1', port))
    except OSError as error:
        raise ServiceError(
            f'Port 127.0.0.1:{port} unavailable (already in use or bind denied). '
            f'No process was killed. Inspect: lsof -nP -iTCP:{port} -sTCP:LISTEN'
        ) from error


