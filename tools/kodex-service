# Review the new release's complete package and digests before adding a version.
OFFICIAL_PACKAGE_SHA256 = {
    '0.160.0': {
        'aarch64-apple-darwin': '007df41b607dbbc8d204b9746ce7fed2d4ce6c813f44c32ceee54175ca796525',
        'x86_64-apple-darwin': '4d50514b2d8acd81ca8cfee55b667b3dc4f7681b65bf3299ff06b11a064f8861',
        'aarch64-unknown-linux-musl': '7f0fe42ff22ecfa3a47bc4a34f5b22c4218b431a4ec0aba51c7d98299f07900c',
        'x86_64-unknown-linux-musl': '4fcc47ab57f52ff75363951a8761146cd10c8288bd86fed45487dbb204a16b71',
    },
}


def native_environment(home):
    env = {key: os.environ[key] for key in ('HOME', 'PATH', 'USER', 'TMPDIR') if key in os.environ}
    env['CODEX_HOME'] = str(home)
    return env


def native_target():
    architecture = {'arm64': 'aarch64', 'aarch64': 'aarch64', 'x86_64': 'x86_64'}.get(platform.machine())
    operating_system = {'Darwin': 'apple-darwin', 'Linux': 'unknown-linux-musl'}.get(platform.system())
    if not architecture or not operating_system:
        raise ServiceError(f'Unsupported runtime platform {platform.system()} {platform.machine()}')
    return f'{architecture}-{operating_system}'


def acquire_native(version, stage):
    target = native_target()
    digest = OFFICIAL_PACKAGE_SHA256.get(version, {}).get(target)
    if not digest:
        raise ServiceError(f'No verified upstream package pinned for Codex {version} on {platform.machine()}')
    asset = f'codex-package-{target}.tar.gz'
    url = f'https://github.com/openai/codex/releases/download/rust-v{version}/{asset}'
    archive = stage / '.native.tar.gz'
    actual = hashlib.sha256()
    try:
        with urllib.request.urlopen(url, timeout=30) as response, archive.open('wb') as output:
            for chunk in iter(lambda: response.read(1024 * 1024), b''):
                actual.update(chunk)
                output.write(chunk)
        if actual.hexdigest() != digest:
            raise ServiceError(f'Codex download checksum mismatch for {asset}; service unchanged')
        native = stage / 'native'
        with tarfile.open(archive) as package:
            members = package.getmembers()
            if any(Path(member.name).is_absolute() or '..' in Path(member.name).parts
                   or not (member.isfile() or member.isdir()) for member in members):
                raise ServiceError('Unsupported Codex archive layout; service unchanged')
            package.extractall(native, members=members)
    except OSError as error:
        raise ServiceError(f'Could not acquire pinned Codex {version}: {error}; service unchanged') from error
    finally:
        archive.unlink(missing_ok=True)
    metadata = json.loads((native / 'codex-package.json').read_text())
    if (metadata.get('layoutVersion') != 1 or metadata.get('version') != version
            or metadata.get('target') != target or metadata.get('variant') != 'codex'
            or metadata.get('entrypoint') != 'bin/codex'
            or metadata.get('resourcesDir') != 'codex-resources' or metadata.get('pathDir') != 'codex-path'):
        raise ServiceError('Unsupported pinned Codex package metadata; service unchanged')
    for name in ('bin/codex', 'bin/codex-code-mode-host', 'codex-path/rg', 'codex-resources/zsh/bin/zsh'):
        path = native / name
        if not path.is_file() or not os.access(path, os.X_OK):
            raise ServiceError(f'Pinned Codex package missing executable {name}; service unchanged')
    if native_version(native / 'bin/codex') != version:
        raise ServiceError('Codex executable version mismatch; service unchanged')
    with tempfile.TemporaryDirectory(prefix='kodex-host-check-') as home:
        run([native / 'bin/codex-code-mode-host', '--help'], capture_output=True,
            text=True, timeout=15, env=native_environment(home))
    (stage / 'codex').symlink_to('native/bin/codex')
    return {'asset': asset, 'sha256': digest, 'url': url}


def native_version(binary):
    with tempfile.TemporaryDirectory(prefix='kodex-version-') as home:
        env = native_environment(home)
        result = run([binary, '--version'], capture_output=True, text=True, timeout=15, env=env)
    match = re.fullmatch(r'codex-cli (\S+)\s*', result.stdout)
    if not match:
        raise ServiceError('Configured Codex executable returned an unknown version format')
    return match[1]


class Service:
    def __init__(self, root, agents=None, *, platform_name=None, role=None, units=None):
        self.root = root.expanduser().resolve()
        self.platform_name = platform_name or sys.platform
        self.role = role
        if self.role not in ('executor', 'federator'):
            raise ServiceError(f'Unknown service role {self.role}')
        self.label = f'dev.kodex.{self.role}'
        self.config_path = self.root / 'config.json'
        extension = 'plist' if self.platform_name == 'darwin' else 'service'
        self.definition = self.root / f'{self.label}.{extension}'
        if self.platform_name == 'darwin':
            self.login_definition = (agents or Path.home() / 'Library/LaunchAgents') / self.definition.name
        else:
            self.login_definition = (units or Path.home() / '.config/systemd/user') / self.definition.name
        # Retain these aliases for shared operation code and tests.
        self.plist = self.definition
        self.login_plist = self.login_definition
        self.domain = f'gui/{os.getuid()}'
        self.target = f'{self.domain}/{self.label}' if self.platform_name == 'darwin' else self.definition.name

    def config(self):
        if not self.config_path.exists():
            raise ServiceError('Not installed. Run install --repo /absolute/path/to/kodex')
        return self.validate_config(json.loads(self.config_path.read_text()))

    def validate_config(self, config):
        configured_role = config.get('role')
        if configured_role != self.role:
            raise ServiceError(f'Configuration belongs to {configured_role}, not {self.role}')
        if not isinstance(config['port'], int) or not 1024 <= config['port'] <= 65535:
            raise ServiceError('port must be an integer between 1024 and 65535')
        if self.role == 'federator':
            if (not isinstance(config.get('sandbox_port'), int)
                    or not 1024 <= config['sandbox_port'] <= 65535
                    or config['sandbox_port'] == config['port']):
                raise ServiceError('sandbox_port must be a distinct integer between 1024 and 65535')
            _, public_origin = validated_http_url(config.get('public_origin'), 'public_origin', '')
            _, sandbox_origin = validated_http_url(
                config.get('sandbox_public_url'), 'sandbox_public_url',
                '/app-surface-sandbox.html')
            if public_origin == sandbox_origin:
                raise ServiceError('sandbox_public_url must use a distinct origin from public_origin')
        if not Path(config['data_dir']).is_absolute():
            raise ServiceError('data_dir must be an absolute path')
        return config

    def bootstrap_controller(self, controller):
        source = Path(controller).resolve().parent
        destination = self.root / 'bootstrap-controller'
        if destination.exists() or destination.is_symlink():
            raise ServiceError(f'Incomplete controller installation already exists at {destination}')
        stage = Path(tempfile.mkdtemp(prefix='.controller-', dir=self.root))
        try:
            for name in CONTROLLER_FILES:
                shutil.copy2(source / name, stage / name)
            stage.rename(destination)
            link(self.root / 'controller', destination)
            link(self.root / 'kodex-service', self.root / 'controller/kodex-service')
        except BaseException:
            for path in (self.root / 'kodex-service', self.root / 'controller'):
                path.unlink(missing_ok=True)
            if stage.exists():
                shutil.rmtree(stage)
            if destination.exists():
                shutil.rmtree(destination)
            raise

    def remove_bootstrap_controller(self):
        for path in (self.root / 'kodex-service', self.root / 'controller'):
            path.unlink(missing_ok=True)
        shutil.rmtree(self.root / 'bootstrap-controller', ignore_errors=True)

    def environment(self, release):
        config = self.config()
        env = {key: os.environ[key] for key in ('HOME', 'USER', 'LOGNAME', 'TMPDIR') if key in os.environ}
        env.update({'PATH': config['path'], 'LANG': 'en_US.UTF-8'})
        if self.role == 'executor':
            env.update({
                'KODEX_BIND': f"127.0.0.1:{config['port']}",
                'KODEX_CONTROL_BIND': '127.0.0.1:0',
                'KODEX_DATA_DIR': config['data_dir'],
                'KODEX_CODEX_BINARY': str(release / 'codex'),
            })
        else:
            env.update({
                'KODEX_FEDERATOR_BIND': f"127.0.0.1:{config['port']}",
                'KODEX_FEDERATOR_SANDBOX_BIND': f"127.0.0.1:{config['sandbox_port']}",
                'KODEX_FEDERATOR_DATA_DIR': config['data_dir'],
                'KODEX_FEDERATOR_PUBLIC_ORIGIN': config['public_origin'],
                'KODEX_FEDERATOR_SANDBOX_PUBLIC_URL': config['sandbox_public_url'],
                'KODEX_FRONTEND_DIST': str(release / 'frontend'),
            })
        # Explicit, narrowly scoped optional settings; never import an old production env file.
        optional = config.get('environment', {})
        allowed = {'RUST_LOG'}
        if self.role == 'federator':
            allowed |= {'KODEX_VAPID_PUBLIC_KEY', 'KODEX_VAPID_PRIVATE_KEY', 'KODEX_VAPID_SUBJECT'}
        if self.role == 'executor':
            allowed.add('KODEX_NOTIFICATIONS_RECHECK_DELAY_MS')
        if set(optional) - allowed or any(not isinstance(value, str) for value in optional.values()):
            raise ServiceError('Unsupported environment setting in service config')
        env.update(optional)
        return env

    def command(self, release):
        if self.role == 'federator':
            return [release / 'kodex-federator']
        return [release / 'kodex-gateway']

    def check_login_owner(self):
        if self.login_plist.exists():
            owner = plistlib.loads(self.login_plist.read_bytes()).get('WorkingDirectory')
            if not owner or Path(owner).resolve() != self.root:
                raise ServiceError('Login job belongs to another installation; use its management command')

    def job(self):
        if self.platform_name == 'linux':
            result = subprocess.run(
                [SYSTEMCTL, '--user', 'show', self.target, '--property=LoadState',
                 '--property=ActiveState', '--property=MainPID', '--property=FragmentPath'],
                capture_output=True, text=True)
            if result.returncode:
                if 'not found' in result.stderr.lower() or 'not loaded' in result.stderr.lower():
                    return None
                raise ServiceError(f'Cannot inspect systemd user unit: {result.stderr.strip()}')
            values = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
            if values.get('LoadState') == 'not-found':
                return None
            fragment = values.get('FragmentPath')
            if fragment and Path(fragment).resolve() != self.login_definition.resolve():
                raise ServiceError('Loaded unit belongs to another installation; use its management command')
            pid = int(values.get('MainPID', '0') or 0)
            return {'pid': pid or None, 'active': values.get('ActiveState') == 'active'}
        result = subprocess.run([LAUNCHCTL, 'print', self.target], capture_output=True, text=True)
        if result.returncode:
            if 'Could not find service' in result.stderr or 'Could not find specified service' in result.stderr:
                return None
            raise ServiceError(f'Cannot inspect launchd job: {result.stderr.strip()}')
        owner = re.search(r'^\s*working directory = (.+)$', result.stdout, re.MULTILINE)
        if not owner or Path(owner[1].strip()).resolve() != self.root:
            raise ServiceError('Loaded job belongs to another installation; use its management command')
        match = re.search(r'^\s*pid = (\d+)\s*$', result.stdout, re.MULTILINE)
        return {'pid': int(match[1]) if match else None}

    def write_service_definition(self):
        if self.platform_name == 'linux':
            logs = self.root / 'logs'
            logs.mkdir(exist_ok=True)
            arguments = [sys.executable, self.root / 'current/kodex-service', '--root', self.root,
                         '--role', self.role, '_run']
            quoted = ' '.join(shlex.quote(str(argument)).replace('%', '%%') for argument in arguments)
            payload = ('[Unit]\nDescription=Kodex ' + self.role + '\nAfter=network-online.target\n'
                       'Wants=network-online.target\n\n[Service]\nType=simple\nExecStart=' + quoted + '\n'
                       'Restart=on-failure\nRestartSec=30\nTimeoutStopSec=35\n'
                       'StandardOutput=append:' + str(logs / 'service.log') + '\n'
                       'StandardError=append:' + str(logs / 'service-error.log') + '\n'
                       'WorkingDirectory=' + str(self.root) + '\n\n[Install]\nWantedBy=default.target\n')
            self.definition.write_text(payload)
            if self.login_definition.exists():
                self.login_definition.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(self.definition, self.login_definition)
            return
        self.check_login_owner()
        logs = self.root / 'logs'
        logs.mkdir(exist_ok=True)
        payload = {
            'Label': self.label,
            'ProgramArguments': [sys.executable, str(self.root / 'current/kodex-service'),
                                 '--root', str(self.root), '--role', self.role, '_run'],
            'WorkingDirectory': str(self.root),
            'RunAtLoad': True,
            'KeepAlive': {'SuccessfulExit': False},
            'ThrottleInterval': 30,
            'ExitTimeOut': 20,
            'StandardOutPath': str(logs / 'service.log'),
            'StandardErrorPath': str(logs / 'service-error.log'),
        }
        self.plist.write_bytes(plistlib.dumps(payload))
        if self.login_plist.exists():
            shutil.copy2(self.plist, self.login_plist)

    def write_plist(self):
        self.write_service_definition()

    def start(self):
        release = (self.root / 'current').resolve(strict=True)
        job = self.job()
        if job and not job['pid']:
            self.stop()
            job = None
        if job is None:
            check_port(self.config()['port'])
            if self.role == 'federator':
                check_port(self.config()['sandbox_port'])
            self.write_service_definition()
            if self.platform_name == 'linux':
                self.login_definition.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(self.definition, self.login_definition)
                run([SYSTEMCTL, '--user', 'daemon-reload'])
                run([SYSTEMCTL, '--user', 'start', self.target])
            else:
                run([LAUNCHCTL, 'bootstrap', self.domain, self.plist])
        try:
            self.health(release)
        except Exception:
            self.stop()
            raise
        print(f"Kodex ready at http://127.0.0.1:{self.config()['port']}")

    def stop(self):
        job = self.job()
        if job is None:
            return
        if self.platform_name == 'linux':
            run([SYSTEMCTL, '--user', 'stop', self.target])
            return
        run([LAUNCHCTL, 'bootout', self.target])
        # bootout can return before the executable has finished its graceful shutdown.
        if job['pid']:
            deadline = time.monotonic() + 35
            while time.monotonic() < deadline:
                try:
                    os.kill(job['pid'], 0)
                except ProcessLookupError:
                    return
                time.sleep(0.2)
            raise ServiceError('Service did not exit; release was not replaced')

    def health(self, release, *, expected_pid=None, api_version=None):
        config = self.config()
        endpoint = f"http://127.0.0.1:{config['port']}"
        sandbox_endpoint = (f"http://127.0.0.1:{config['sandbox_port']}"
                            if self.role == 'federator' else None)
        primary_host = (urllib.parse.urlsplit(config['public_origin']).netloc
                        if self.role == 'federator' else None)
        sandbox_host = (urllib.parse.urlsplit(config['sandbox_public_url']).netloc
                        if self.role == 'federator' else None)
        manifest = json.loads((release / 'manifest.json').read_text())
        if manifest.get('role') != self.role:
            raise ServiceError(f'Release belongs to {manifest.get("role")}, not {self.role}')
        expected_index = ((release / 'frontend/index.html').read_bytes()
                          if self.role == 'federator' else None)
        expected_sandbox = ((release / 'frontend/app-surface-sandbox.html').read_bytes()
                            if self.role == 'federator' else None)
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            try:
                def read(path):
                    target = endpoint + path
                    request = (urllib.request.Request(target, headers={'Host': primary_host})
                               if primary_host else target)
                    with opener.open(request, timeout=2) as response:
                        return response.read()
                def read_sandbox(path):
                    request = urllib.request.Request(
                        sandbox_endpoint + path, headers={'Host': sandbox_host})
                    with opener.open(request, timeout=2) as response:
                        return response.read()
                job = self.job()
                if expected_pid is not None and (not job or job['pid'] != expected_pid):
                    raise ServiceError('Federator PID changed during frontend deployment; process unchanged by controller')
                if not job or not job['pid']:
                    raise ValueError('job has no running process')
                if self.platform_name == 'darwin':
                    lsof = shutil.which('lsof') or '/usr/sbin/lsof'
                    owners = subprocess.run([lsof, '-nP', '-t',
                                             f'-iTCP:{config["port"]}', '-sTCP:LISTEN'],
                                            capture_output=True, text=True)
                    if str(job['pid']) not in owners.stdout.split():
                        raise ValueError('listener is not the owned launchd process')
                if self.role == 'federator':
                    health = json.loads(read('/healthz'))
                    if api_version is not None and manifest.get('api_version') != api_version:
                        raise ServiceError('Frontend API version does not match running federator; use a full update')
                    if (health['ready'] is True and health['service'] == 'kodex-federator'
                            and read('/') == expected_index
                            and read_sandbox('/app-surface-sandbox.html') == expected_sandbox):
                        return job['pid']
                else:
                    capabilities = json.loads(read('/v1/capabilities'))
                    marker = json.loads((Path(self.config()['data_dir']) / 'instance.json').read_text())
                    native = capabilities['appServer']
                    if api_version is not None and capabilities['gateway']['apiVersion'] != api_version:
                        raise ServiceError('Frontend API version does not match running gateway; use a full update')
                    frontend_matches = expected_index is None or read('/') == expected_index
                    if (json.loads(read('/readyz'))['ready'] is True
                            and capabilities['gateway']['instanceId'] == marker['id']
                            and native['schemaVersion'] == manifest['schema_version']
                            and native['detectedVersionMatchesSchema'] is True
                            and frontend_matches):
                        return job['pid']
            except (OSError, ValueError, KeyError):
                pass
            time.sleep(0.5)
        raise ServiceError(f'Health check failed at {endpoint}; inspect kodex-service logs')

    def notify_frontend_updated(self, revision):
        config = self.config()
        endpoint = f"http://127.0.0.1:{config['port']}/v1/frontend-updates"
        headers = {
            'Content-Type': 'application/json',
            'x-kodex-api-version': '4',
            'Host': urllib.parse.urlsplit(config['public_origin']).netloc,
        }
        request = urllib.request.Request(
            endpoint,
            data=json.dumps({'revision': revision}).encode(),
            headers=headers,
            method='POST',
        )
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=2) as response:
            if response.status != 204:
                raise ServiceError(f'Federator rejected frontend update notification with HTTP {response.status}')

    def autostart(self, enabled):
        if self.platform_name == 'linux':
            self.write_service_definition()
            self.login_definition.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(self.definition, self.login_definition)
            run([SYSTEMCTL, '--user', 'daemon-reload'])
            run([SYSTEMCTL, '--user', 'enable' if enabled else 'disable', self.target])
            print(f"Login autostart {'enabled' if enabled else 'disabled'}; current process unchanged")
            return
        self.check_login_owner()
        if enabled:
            self.login_plist.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(self.plist, self.login_plist)
        else:
            self.login_plist.unlink(missing_ok=True)
        print(f"Login autostart {'enabled' if enabled else 'disabled'}; current process unchanged")

    def autostart_enabled(self):
        if self.platform_name == 'linux':
            result = subprocess.run([SYSTEMCTL, '--user', 'is-enabled', self.target],
                                    capture_output=True, text=True)
            return result.returncode == 0 and result.stdout.strip() == 'enabled'
        return self.login_plist.exists()

    def build(self, repo):
        repo = repo.resolve(strict=True)
        releases = self.root / 'releases'
        releases.mkdir(exist_ok=True)
        stage = Path(tempfile.mkdtemp(prefix='.stage-', dir=releases))
        try:
            manifest = {'role': self.role}
            if self.role == 'executor':
                source = (repo / 'apps/gateway/src/schema.rs').read_text()
                version = re.search(r'APP_SERVER_SCHEMA_VERSION: &str = "([^"]+)"', source)[1]
                native = acquire_native(version, stage)
                run(['cargo', 'build', '--release', '--locked', '-p', 'kodex-gateway',
                     '--target-dir', repo / 'target'], cwd=repo)
                shutil.copy2(repo / 'target/release/kodex-gateway', stage / 'kodex-gateway')
                manifest.update(schema_version=version, native=native)
            if self.role == 'federator':
                source = (repo / 'apps/federator/src/trust.rs').read_text()
                api_version = re.search(r'FEDERATOR_API_VERSION: &str = "([^"]+)"', source)[1]
                manifest['api_version'] = api_version
                run(['cargo', 'build', '--release', '--locked', '-p', 'kodex-federator',
                     '--target-dir', repo / 'target'], cwd=repo)
                shutil.copy2(repo / 'target/release/kodex-federator', stage / 'kodex-federator')
                run(['npm', 'ci'], cwd=repo / 'apps/web')
                build_env = dict(os.environ, VITE_KODEX_API_BASE_URL='')
                run(['npm', 'run', 'build'], cwd=repo / 'apps/web', env=build_env)
                shutil.copytree(repo / 'apps/web/dist', stage / 'frontend')
            for name in CONTROLLER_FILES:
                shutil.copy2(repo / 'tools' / name, stage / name)
            (stage / 'manifest.json').write_text(json.dumps(manifest))
            destination = releases / (time.strftime('%Y%m%d-%H%M%S') + '-' + uuid.uuid4().hex[:8])
            stage.rename(destination)
            return destination
        except BaseException:
            shutil.rmtree(stage)
            raise

    def update_frontend(self, repo):
        if self.role != 'federator':
            raise ServiceError('Executor releases do not contain web assets')
        repo = repo.resolve(strict=True)
        release = (self.root / 'current').resolve(strict=True)
        frontend = release / 'frontend'
        if frontend.is_symlink() or not frontend.is_dir():
            raise ServiceError('Current frontend must be a real directory; service unchanged')
        manifest = json.loads((release / 'manifest.json').read_text())
        source = (repo / 'apps/web/src/api/compatibility.ts').read_text()
        version = re.search(r'const API_VERSION = "([^"\n]+)"', source)
        if not version:
            raise ServiceError('Cannot determine frontend API version; service unchanged')
        if version[1] != manifest.get('api_version'):
            raise ServiceError('Checkout API version differs from current federator; use a full update')
        job = self.job()
        if not job or not job['pid']:
            raise ServiceError('Frontend deployment requires the installed federator to be running')
        pid = job['pid']
        self.health(release, expected_pid=pid, api_version=version[1])
        stage = Path(tempfile.mkdtemp(prefix='.frontend-', dir=release))
        staged_frontend = stage / 'frontend'
        keep_backup = False
        try:
            run(['npm', 'ci'], cwd=repo / 'apps/web')
            run(['npm', 'run', 'build'], cwd=repo / 'apps/web',
                env=dict(os.environ, VITE_KODEX_API_BASE_URL=''))
            shutil.copytree(repo / 'apps/web/dist', staged_frontend)
            if not (staged_frontend / 'index.html').is_file():
                raise ServiceError('Frontend build has no index.html; service unchanged')
            revision = frontend_revision(staged_frontend)
            self.health(release, expected_pid=pid, api_version=version[1])
            if (self.root / 'current').resolve(strict=True) != release:
                raise ServiceError('Current release changed during frontend build; service unchanged')
            retain_frontend_assets(frontend, staged_frontend)
            swap_directories(frontend, staged_frontend)
            try:
                self.health(release, expected_pid=pid, api_version=version[1])
            except BaseException as error:
                try:
                    swap_directories(frontend, staged_frontend)
                except BaseException as rollback_error:
                    keep_backup = True
                    raise ServiceError(f'Frontend rollback failed; original frontend retained at {staged_frontend}; '
                                       'no process was stopped or started') from rollback_error
                try:
                    self.health(release, expected_pid=pid, api_version=version[1])
                except Exception as rollback_error:
                    raise ServiceError('Frontend rolled back, but federator health failed; '
                                       'no process was stopped or started') from rollback_error
                if not isinstance(error, Exception):
                    raise
                raise ServiceError('Frontend health failed and frontend was rolled back; '
                                   'no process was stopped or started') from error
            try:
                self.notify_frontend_updated(revision)
            except Exception as error:
                print(f'Frontend updated, but the live update notice failed: {error}', file=sys.stderr)
        finally:
            if not keep_backup:
                shutil.rmtree(stage)
        print(f'Frontend updated; federator PID {pid} unchanged')

    def update(self, repo):
        release = self.build(repo)  # Build failures cannot stop or replace the live release.
        self.stop()
        current = self.root / 'current'
        if current.exists():
            link(self.root / 'previous', current.resolve())
        link(current, release)
        # Keep the management controller independent of runtime rollback.
        link(self.root / 'controller', release)
        link(self.root / 'kodex-service', self.root / 'controller/kodex-service')
        shutil.rmtree(self.root / 'bootstrap-controller', ignore_errors=True)
        try:
            self.start()
        except Exception:
            self.stop()
            raise

    def rollback(self, compatible):
        if not compatible:
            raise ServiceError('Rollback requires --data-compatible after reviewing storage compatibility; '
                               'persistent state is never rolled back')
        previous = (self.root / 'previous').resolve(strict=True)
        current = (self.root / 'current').resolve(strict=True)
        self.stop()
        link(self.root / 'current', previous)
        link(self.root / 'previous', current)
        self.start()

    def execute(self):
        release = (self.root / 'current').resolve(strict=True)
        try:
            config = self.config()
            check_port(config['port'])
            if self.role == 'federator':
                check_port(config['sandbox_port'])
        except ServiceError as error:
            # Applies on login/crash restart too. Successful exit avoids a port-conflict restart loop.
            print(error, file=sys.stderr)
            return
        command = self.command(release)
        os.execve(command[0], [str(argument) for argument in command], self.environment(release))


@contextlib.contextmanager
def locked(root, wait=False):
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (root / '.service.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError as error:
            raise ServiceError('Another service management command is running') from error
        yield


