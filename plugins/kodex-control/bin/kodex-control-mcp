#!/bin/sh
set -eu

# Managed native launches provide the running gateway binary and bound URL.
# This also works before the gateway begins serving startup recovery requests.
if [ -n "${KODEX_GATEWAY_BINARY:-}" ]; then
  exec "$KODEX_GATEWAY_BINARY" mcp kodex-control
fi

if command -v kodex-gateway >/dev/null 2>&1; then
  exec kodex-gateway mcp kodex-control
fi

# Source-checkout development convenience; installed caches use the binding above.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
if [ -x "$repo_root/target/debug/kodex-gateway" ]; then
  exec "$repo_root/target/debug/kodex-gateway" mcp kodex-control
fi

echo "kodex-control requires KODEX_GATEWAY_BINARY or kodex-gateway on PATH" >&2
exit 127
