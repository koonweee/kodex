{
  "name": "@kodex/mastra-code-sdk-spike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit",
    "login": "node --import tsx src/login.ts",
    "live": "node --import tsx src/live.ts",
    "benchmark": "node --import tsx src/benchmark.ts",
    "build": "tsc --project tsconfig.build.json",
    "benchmark:built": "node dist/benchmark.js",
    "serve": "node --import tsx src/serve.ts",
    "serve:built": "node dist/serve.js"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@mastra/code-sdk": "1.11.0",
    "@mastra/core": "1.75.0",
    "@mastra/libsql": "1.25.1",
    "@mastra/memory": "1.36.0",
    "@orpc/client": "1.15.4",
    "@orpc/server": "1.15.4",
    "node-pty": "1.2.0-beta.15",
    "shlex": "3.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
